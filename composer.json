{
  "name": "h4kuna/data-type",
  "type": "library",
  "description": "Basic data type, int, float, string, set, gps",
  "homepage": "https://github.com/h4kuna/data-type",
  "license": "MIT",
  "authors": [
    {
      "name": "Milan Matějček",
      "email": "milan.matejcek@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-mbstring": "*",
    "nette/utils": "^3.2.8 || ^4.0"
  },
  "autoload": {
    "psr-4": {
      "h4kuna\\DataType\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "h4kuna\\DataType\\Tests\\": "tests/src"
    }
  },
  "require-dev": {
    "nette/tester": "^2.4",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "shipmonk/coding-standard": "^0.2",
    "tracy/tracy": "^2.9"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "cbf": "vendor/bin/phpcbf",
    "coverage": "vendor/bin/tester --coverage coverage.html --coverage-src src/ --colors 1 -s -C tests/src",
    "cs": "vendor/bin/phpcs",
    "qa": [
      "@tests",
      "@cs",
      "@stan"
    ],
    "stan": "vendor/bin/phpstan analyse",
    "tests": "vendor/bin/tester --colors 1 -s -C tests/src"
  }
}
